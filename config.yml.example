# UI language: "en" (default) or "chs"
uiLanguage: "en"

# Default output root directory; each client exports to <outputRoot>/<lang> unless outputDir is set
outputRoot: "./rawexd"

# Shared settings for global clients (en, ja, de, fr)
global:
  path: "C:/Program Files (x86)/SquareEnix/FINAL FANTASY XIV - A Realm Reborn"
  # schemaVersion: "" # Auto-detected via ffxivgame.ver; falls back to "latest"

# Per-client settings (path/outputDir/schemaVersion are all optional overrides)
clients:
  en:
  ja:
  de:
  fr:
  chs:
    path: "C:/Program Files (x86)/上海数龙科技有限公司/最终幻想XIV"
  ko:
    path: "D:/game/FFXIV_KO"
    # schemaVersion: "" # Auto-detected via ffxivgame.ver; falls back to "latest"
  tc:
    path: "D:/game/FFXIV_TC"
    # schemaVersion: "" # Auto-detected via ffxivgame.ver; falls back to "latest"
